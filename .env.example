# Copy to .env for local overrides. Never commit .env.
# No API keys are needed for Phase 0/1 - everything runs offline.

# SQLite database path (relative to repo root or absolute)
STEAM_STUDY_DB=.local/steam_study.sqlite3

# Catalog qualification floor in USD (estimated gross revenue)
STEAM_STUDY_QUALIFICATION_MIN_REVENUE_USD=100000

# Directory for rotating JSON logs
STEAM_STUDY_LOG_DIR=.local/logs

# Phase 3+ only (do not set yet):
# STEAM_API_KEY=
# Phase 5+ only (do not set yet):
# OPENAI_API_KEY=
