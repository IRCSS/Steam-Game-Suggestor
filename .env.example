# Optional developer overrides. Copy to .env (never commit .env).
# App settings (data folder, revenue floor, API keys, LLM, cost model) live in settings.json,
# which the app creates on first run and edits through the gear icon - not here.

# Folder that holds settings.json, data/ and studiesJPG/ (default in development: .local)
# STEAM_STUDY_APP_DIR=.local

# 1 = never contact Steam or Claude (tests use this)
# STEAM_STUDY_OFFLINE=1
