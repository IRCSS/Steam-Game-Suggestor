      "SuggestionQuery": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "title": "Session Id"
          },
          "filters": {
            "$ref": "#/components/schemas/StudyFiltersModel"
          },
          "avoid_repeats": {
            "type": "boolean",
            "title": "Avoid Repeats",
            "default": true
          },
          "include_below_threshold": {
            "type": "boolean",
            "title": "Include Below Threshold",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "filters"
        ],
        "title": "SuggestionQuery"
      },
      "SuggestionRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "title": "Session Id"
          },
          "filters": {
            "$ref": "#/components/schemas/StudyFiltersModel"
          },
          "avoid_repeats": {
            "type": "boolean",
            "title": "Avoid Repeats",
            "default": true
          },
          "include_below_threshold": {
            "type": "boolean",
            "title": "Include Below Threshold",
