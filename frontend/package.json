{
  "name": "steam-study-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-api": "openapi-typescript openapi.json -o src/api/schema.ts",
    "gen-api:check": "openapi-typescript openapi.json -o .schema.check.ts && node -e \"const f=require('fs');const a=f.readFileSync('src/api/schema.ts','utf8'),b=f.readFileSync('.schema.check.ts','utf8');f.unlinkSync('.schema.check.ts');if(a!==b){console.error('src/api/schema.ts is stale: run npm run gen-api');process.exit(1)}console.log('API types up to date')\""
  }
}
